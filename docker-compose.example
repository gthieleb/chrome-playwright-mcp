# Example docker-compose configuration for Chrome MCP
# Copy this to docker-compose.yml and customize as needed
# NOTE: This file should be kept local and not committed to version control

services:
  chrome-mcp:
    image: chrome-mcp:latest
    build:
      context: .
      dockerfile: Dockerfile
    container_name: chrome-mcp
    restart: unless-stopped
    # Bind to 127.0.0.1 for local-only access (security best practice)
    ports:
      - "127.0.0.1:3000:3000"    # KasmVNC web interface (HTTP)
      - "127.0.0.1:3001:3001"    # KasmVNC VNC proxy (HTTPS)
      - "127.0.0.1:3002:3002"    # Playwright MCP server
    volumes:
      - ./config:/config
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Berlin
    shm_size: "2gb"