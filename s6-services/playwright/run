#!/usr/bin/with-contenv bash

# === Playwright MCP runner (stock @playwright/mcp) ===
# Runs the official implementation only; selector env is obsolete.
# Kept for compatibility: PLAYWRIGHT_IMPLEMENTATION is ignored.

# Create runtime directories (/config is a runtime volume from base image)
mkdir -p /config/chrome-profile /config/mcp-profile /config/output /config/sessions

# Seed Chrome prefs for the persistent MCP profile: restore tabs on startup
# ("continue where you left off") so tabs survive browser/pod restarts.
PREFS="/config/mcp-profile/Default/Preferences"
if [ ! -f "$PREFS" ]; then
  mkdir -p "$(dirname "$PREFS")"
  echo '{"session":{"restore_on_startup":1},"bookmark_bar":{"show_on_all_tabs":true}}' > "$PREFS"
fi

# Copy default config (base image /config is a volume, so image-built files are hidden)
# Force-sync: config ships container wiring (CDP port for session-tools,
# persistent profile dir) that older PVCs lack. Backup existing user config once.
if [ -f /config/config.json ]; then
  cp /config/config.json /config/config.json.user.bak
fi
install -m 0644 -o abc -g abc /defaults/config.json /config/config.json

# Openbox autostart + menu are image code, not user state: force-sync them so
# desktop fixes (e.g. Chrome autostart) reach existing PVCs on every boot.
# init-kasmvnc-config only copies when missing, which would pin old versions.
mkdir -p /config/.config/openbox
install -m 0644 -o abc -g abc /defaults/autostart /config/.config/openbox/autostart
install -m 0644 -o abc -g abc /defaults/menu.xml /config/.config/openbox/menu.xml

chown -R abc:abc /config/chrome-profile /config/mcp-profile /config/output /config/sessions
chmod -R u+rwX /config/chrome-profile /config/mcp-profile /config/output /config/sessions

echo "Starting Playwright MCP (official @playwright/mcp)"

# Allow-list note: stock 0.0.81+ rejects requests whose Host header differs from
# the bind address ("Access is only allowed at localhost"). This container is only
# reachable via Tailscale service ingress, so the check is disabled deliberately.
exec s6-setuidgid abc env HOME=/home/kasm-user /usr/bin/playwright-mcp \
  --config /config/config.json \
  --output-dir /config/output \
  --idle-timeout 3600000 \
  --allowed-hosts '*' \
  >> /config/output/playwright-mcp.log 2>&1